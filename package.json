{
  "name": "paso-urbano",
  "version": "1.0.0",
  "private": true,
  "description": "Tienda universitaria de zapatos: microservicios y arquitectura hexagonal",
  "scripts": {
    "start": "npm run build && node --env-file=.env src/main.js",
    "start:catalog": "node --env-file=.env src/catalog-service/main.js",
    "start:orders": "node --env-file=.env src/orders-service/main.js",
    "start:users": "node --env-file=.env src/users-service/main.js",
    "start:gateway": "npm run build && node --env-file=.env src/gateway-main.js",
    "start:all": "node --env-file=.env src/main.js",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build"
  },
  "engines": {
    "node": ">=22.9"
  },
  "type": "module",
  "dependencies": {
    "express": "^5.3.0",
    "mysql2": "^3.24.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "vite": "^8.3.5"
  }
}
