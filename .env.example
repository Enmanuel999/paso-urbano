# Local MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_CATALOG_DATABASE=paso_catalog
MYSQL_ORDERS_DATABASE=paso_orders
MYSQL_USERS_DATABASE=paso_users

# Service addresses (defaults are suitable for local development)
CATALOG_SERVICE_URL=http://127.0.0.1:3101
# Shared secret between Pedidos and Catálogo for inventory operations; choose a private value.
CATALOG_INTERNAL_TOKEN=replace-with-a-long-random-secret
ORDERS_SERVICE_URL=http://127.0.0.1:3102
USERS_SERVICE_URL=http://127.0.0.1:3103
CATALOG_PORT=3101
ORDERS_PORT=3102
USERS_PORT=3103
GATEWAY_PORT=3000
