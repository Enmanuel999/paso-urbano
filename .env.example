# Local MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_CATALOG_DATABASE=paso_catalog
MYSQL_ORDERS_DATABASE=paso_orders
MYSQL_USERS_DATABASE=paso_users

# Service addresses
CATALOG_SERVICE_URL=http://127.0.0.1:3101
# Set a private random value in .env; never commit the real token.
CATALOG_INTERNAL_TOKEN=
ORDERS_SERVICE_URL=http://127.0.0.1:3102
USERS_SERVICE_URL=http://127.0.0.1:3103
CATALOG_PORT=3101
ORDERS_PORT=3102
USERS_PORT=3103
GATEWAY_PORT=3000

# Admin único. Configura ambos valores en .env; contraseña de al menos 16 caracteres.
ADMIN_USERNAME=
ADMIN_PASSWORD=